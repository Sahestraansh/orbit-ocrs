# Copy this file to .env.local after running `npm run db:start`.
# Replace the three key placeholders with the values printed by `npm run db:status`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_LOCAL_PUBLISHABLE_KEY_HERE
SUPABASE_SECRET_KEY=PASTE_LOCAL_SECRET_KEY_HERE
NEXT_PUBLIC_AUTH_MODE=local
UNIVERSITY_SSO_DOMAIN=
